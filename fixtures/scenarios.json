        "method": "GET"
      },
      {
        "path": "/run/1",
        "body": {
          "runId": "r1",
          "layoutVersion": "v1",
          "receipt": "/accept/r1",
          "channel": {
            "unit": "AU"
          },
          "order": "row-major",
          "readings": [
            {
              "ordinal": 0,
              "value": 0,
              "quality": "ok"
            }
          ]
        },
        "status": 200,
        "method": "GET",
        "denyAfter": "POST /accept/r1"
      },
      {
        "path": "/accept/r1",
        "body": {
          "accepted": true
        },
        "status": 200,
        "method": "POST"
      }
    ],
    "expected": [
      {
        "plateId": "P3",
        "runId": "r1",
        "well": "A1",
        "sampleId": "s1",
        "value": 0
      }
    ],
    "forbidden": [],
    "runs": 2,
    "requiredRequests": [
      "POST /accept/r1"
    ]
  },
