  {
    "name": "layout-after-receipt",
    "routes": [
      {
        "path": "/plate",
        "body": {
          "plateId": "P3",
          "layout": "/layout/v1",
          "runs": [
            "/run/1"
          ]
        },
        "status": 200,
        "method": "GET"
      },
      {
        "path": "/layout/v1",
        "body": {
          "error": "pending"
        },
        "status": 404,
        "method": "GET"
      },
      {
        "path": "/layout/v1",
        "body": {
          "version": "v1",
          "rows": 1,
          "columns": 1,
          "orientation": 0,
          "wells": {
            "A1": {
              "sampleId": "s1",
